<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Students.students.repository.StudentRepository">

  <!--受講生の全件検索 -->
  <select id="search" resultType="Students.students.data.Student">
    SELECT * FROM students
  </select>

  <!--受講生の検索 -->
  <select id="searchStudent" resultType="Students.students.data.Student">
    SELECT * FROM students WHERE id = #{id}
  </select>
<!--受講生コース情報の全件検索-->
  <select id="searchStudentCourseList" resultType="Students.students.data.StudentsCourse">
    SELECT * FROM student_courses
  </select>
<!--受講生コース情報検索-->
  <select id="searchStudentCourse" resultType="Students.students.data.StudentsCourse">
    SELECT * FROM student_courses WHERE studentId = #{studentId}
  </select>

</mapper>